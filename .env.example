# ─────────────────────────────────────────────────────────────────────────────
# ClipForge × Lemon Squeezy — environment variables
# Copy this file to `.env.local` and fill in the values from your Lemon Squeezy
# TEST-MODE store. See SETUP.md for a step-by-step guide on where each comes from.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the running app. Used to build the post-checkout redirect.
# Local dev: http://localhost:3000   ·   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lemon Squeezy API key (test mode).
# Settings → API → "+" to create one. Starts with "eyJ0eXAiOiJKV1Q...".
LEMONSQUEEZY_API_KEY=

# Your store's numeric ID. Found in Settings → Stores (the number, not the name).
LEMONSQUEEZY_STORE_ID=

# Signing secret you set when creating the webhook (Settings → Webhooks).
# Must match exactly — it verifies that webhook calls really came from Lemon Squeezy.
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Product variant IDs ──────────────────────────────────────────────────────
# Each plan below maps to one "variant" in Lemon Squeezy. Open a product, click a
# variant, and copy the numeric ID from the URL (…/variants/123456).
# You can start by filling in just ONE to test, then add the rest.

# Subscription tier: Creator
LEMONSQUEEZY_VARIANT_CREATOR_MONTHLY=
LEMONSQUEEZY_VARIANT_CREATOR_YEARLY=

# Subscription tier: Studio (most popular)
LEMONSQUEEZY_VARIANT_STUDIO_MONTHLY=
LEMONSQUEEZY_VARIANT_STUDIO_YEARLY=

# One-time purchase: Lifetime
LEMONSQUEEZY_VARIANT_LIFETIME=
